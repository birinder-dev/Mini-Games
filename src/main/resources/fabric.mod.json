{
	"schemaVersion": 1,
	"id": "mini-games",
	"version": "${version}",
	"name": "Mini Games",
	"description": "An authentic tavern card gambling minigame. Pull up a stool, wager emeralds on an interactive table against the Gambler NPC, and handle 3D cards that can be fanned, placed, or thrown.",
	"authors": [
		"Birinder"
	],
	"contact": {
		"homepage": "https://github.com/birinder-dev/Mini-Games",
		"sources": "https://github.com/birinder-dev/Mini-Games"
	},
	"license": "CC0-1.0",
	"icon": "assets/minigames/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.alphy90.minigames.MiniGames"
		],
		"client": [
			"dev.alphy90.minigames.client.MiniGamesClient"
		]
	},
	"mixins": [
      "minigames.mixins.json",
		{
			"config": "minigames.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}